# Generate independent random values, keep the real environment file outside Git.
COLLAB_IMAGE=label-studio-collab:local
POSTGRE_PASSWORD=replace-with-a-random-database-password
SECRET_KEY=replace-with-a-persistent-random-django-secret
LABEL_STUDIO_HOST=http://localhost:18080
COLLAB_HTTP_PORT=18080
COLLAB_POSTGRES_PORT=55439
COLLAB_TEST_DEPS=false
# Automatic invitations: configure one mail backend, keeping credentials private.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_USE_SSL=false
# EMAIL_HOST_USER=annotations@example.org
# EMAIL_HOST_PASSWORD=provide-outside-git
# DEFAULT_FROM_EMAIL=annotations@example.org
# Microsoft 365 unattended OAuth2 (no mailbox password):
# EMAIL_BACKEND=collab.microsoft_mail.Microsoft365Backend
# EMAIL_HOST_USER=annotations@example.org
# DEFAULT_FROM_EMAIL=annotations@example.org
# M365_TENANT_ID=tenant-uuid
# M365_CLIENT_ID=application-uuid
# M365_CLIENT_SECRET=provide-outside-git
# Development profile. Keep 1 <= MIN < PROCESSES and MIN <= INITIAL <= PROCESSES.
UWSGI_PROCESSES=2
UWSGI_MIN_PROCESSES=1
UWSGI_INITIAL_PROCESSES=2
# Optional native HTTPS override (certificate directory is outside the repository).
# LABEL_STUDIO_HOST=https://localhost:18443
# COLLAB_TLS_DIR=/absolute/private/path/to/tls
# COLLAB_HTTPS_PORT=18443
